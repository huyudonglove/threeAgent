{
  "name": "agentthee",
  "private": true,
  "version": "0.0.0",
  "description": "Personal AI agent workbench desktop app.",
  "author": "AgentThee Contributors",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "vue-tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "doctor:machine": "powershell -ExecutionPolicy Bypass -File scripts/machine-doctor.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "test:one": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.26"
  },
  "main": "dist-electron/main.js"
}
